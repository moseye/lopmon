# Discord application credentials — https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_GUILD_ID=your-dev-guild-id
# Unused by the gateway bot (only for HTTP-interaction endpoints); kept for parity.
DISCORD_PUBLIC_KEY=your-app-public-key

# PostgreSQL. Compose injects the in-network URL; for local `pnpm dev` point at your own DB.
DATABASE_URL=postgres://lopmon:lopmon@localhost:5432/lopmon

# Ops
NODE_ENV=development
LOG_LEVEL=info
